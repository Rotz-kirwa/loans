PORT=5000
# Use /var/data/fintrust.db on Render when a persistent disk is mounted at /var/data
DATABASE_PATH=
CORS_ALLOWED_ORIGINS=https://loanvia.org,https://www.loanvia.org
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# If omitted on Render, the backend can fall back to RENDER_EXTERNAL_URL + /api/mpesa/callback
MPESA_CALLBACK_URL=https://your-public-https-domain/api/mpesa/callback
# Optional stable backend base URL, for example https://loans-fw8w.onrender.com
PUBLIC_BACKEND_URL=
MPESA_PARTNER_NAME=TrustFund Capital
AFRICASTALKING_SMS_ENV=production
AFRICASTALKING_SMS_USERNAME=
AFRICASTALKING_SMS_API_KEY=
AFRICASTALKING_SMS_SENDER_ID=
